{
  "name": "@billmanager/mobile",
  "version": "1.1.1",
  "main": "index.ts",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "lodash": "^4.18.1",
    "markdown-it": "^14.1.0",
    "query-string": "9.5.1",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "undici": "^7.18.2"
  },
  "scripts": {
    "postinstall": "patch-package",
    "eas-build-post-install": "node scripts/limit-android-native-jobs.mjs",
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "i18n:sync": "node scripts/sync-web-translations.mjs",
    "i18n:check": "node scripts/sync-web-translations.mjs --check",
    "api:generate": "npx --yes openapi-typescript@7.13.0 ../server/openapi.yaml -o src/api/generated/schema.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated/schema.ts",
    "prebuild": "npm run i18n:sync && expo prebuild --clean",
    "prebuild:development": "cross-env BILLMANAGER_DEVELOPMENT_BUILD=true npm run prebuild",
    "android": "cross-env BILLMANAGER_DEVELOPMENT_BUILD=true expo run:android",
    "ios": "cross-env BILLMANAGER_DEVELOPMENT_BUILD=true expo run:ios",
    "web": "expo start --web",
    "audit": "audit-ci --config ./audit-ci.jsonc",
    "lint": "eslint --max-warnings=0 App.tsx app.config.ts src widgets modules plugins",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "maestro:validate": "node scripts/validate-maestro-flows.mjs",
    "config:validate": "node scripts/validate-build-profiles.mjs",
    "doctor": "npx expo-doctor",
    "check": "npm run i18n:check && npm run api:check && npm run lint && npm run typecheck && npm test && npm run maestro:validate && npm run config:validate && npx expo install --check && npm run doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "babel-preset-expo": "~58.0.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.16",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.22",
    "i18next": "^26.5.6",
    "lucide-react-native": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "audit-ci": "7.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "patch-package": "8.0.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "@sentry/cli@3.8.0": true
  }
}
