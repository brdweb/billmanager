{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.19.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "true",
        "BILLMANAGER_SENTRY_TEST_CRASH": "false"
      },
      "ios": {
        "simulator": true
      }
    },
    "development:device": {
      "node": "24.19.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "true",
        "BILLMANAGER_SENTRY_TEST_CRASH": "false"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "node": "24.19.0",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "false",
        "BILLMANAGER_SENTRY_TEST_CRASH": "true"
      }
    },
    "preview:ios": {
      "node": "24.19.0",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "false",
        "BILLMANAGER_SENTRY_TEST_CRASH": "false"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "node": "24.19.0",
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "false",
        "BILLMANAGER_SENTRY_TEST_CRASH": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6800792480"
      }
    }
  }
}
