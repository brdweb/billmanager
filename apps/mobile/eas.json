{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "node": "24.19.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "true"
      },
      "ios": {
        "simulator": true
      }
    },
    "development:device": {
      "node": "24.19.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "true"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "node": "24.19.0",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "false"
      }
    },
    "preview:ios": {
      "node": "24.19.0",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "false"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "node": "24.19.0",
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "BILLMANAGER_DEVELOPMENT_BUILD": "false"
      },
      "android": {
        "buildType": "app-bundle",
        "env": {
          "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-Xmx3g -XX:MaxMetaspaceSize=2g -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8\" -Dorg.gradle.workers.max=1 -Dorg.gradle.parallel=false -Dorg.gradle.daemon=false"
        }
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6800792480"
      }
    }
  }
}
