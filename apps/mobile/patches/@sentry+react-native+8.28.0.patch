+#import "BillManagerSentryPrivacy.h"
+#import <dispatch/dispatch.h>
+
+@import Sentry;
+
+static NSString *const BillManagerRedactedEventValue = @"[redacted]";
+
+static NSString *_Nullable BillManagerMatchingString(id value, NSRegularExpression *pattern)
+{
+    if (![value isKindOfClass:NSString.class]) return nil;
+    NSRange range = NSMakeRange(0, [value length]);
+    NSTextCheckingResult *match = [pattern firstMatchInString:value options:0 range:range];
+    return match != nil && NSEqualRanges(match.range, range) ? value : nil;
+}
+
+static NSDictionary<NSString *, id> *_Nullable BillManagerScrubSdk(NSDictionary *sdk)
+{
+    if (![sdk isKindOfClass:NSDictionary.class]) return nil;
+    static NSRegularExpression *sdkNamePattern;
+    static NSRegularExpression *packageNamePattern;
+    static NSRegularExpression *versionPattern;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        sdkNamePattern = [NSRegularExpression
+            regularExpressionWithPattern:@"^sentry\\.(?:javascript(?:\\.[a-z-]+)*|cocoa(?:\\.react-native)?|(?:java|native)(?:\\.android(?:\\.react-native)?)?)$"
+            options:0 error:NULL];
+        packageNamePattern = [NSRegularExpression
+            regularExpressionWithPattern:@"^(?:npm:@sentry/[a-z-]+|cocoapods:Sentry|maven:io\\.sentry:sentry(?:-android(?:-core|-ndk)?)?)$"
+            options:0 error:NULL];
+        versionPattern = [NSRegularExpression
+            regularExpressionWithPattern:@"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
+            options:0 error:NULL];
+    });
+    NSString *name = BillManagerMatchingString(sdk[@"name"], sdkNamePattern);
+    NSString *version = BillManagerMatchingString(sdk[@"version"], versionPattern);
+    NSMutableArray<NSDictionary<NSString *, NSString *> *> *packages = nil;
+    id rawPackages = sdk[@"packages"];
+    if ([rawPackages isKindOfClass:NSArray.class]) {
+        for (id package in rawPackages) {
+            if (![package isKindOfClass:NSDictionary.class]) continue;
+            NSString *packageName = BillManagerMatchingString(package[@"name"], packageNamePattern);
+            NSString *packageVersion = BillManagerMatchingString(package[@"version"], versionPattern);
+            if (packageName == nil || packageVersion == nil) continue;
+            if (packages == nil) packages = [NSMutableArray new];
+            [packages addObject:@{ @"name": packageName, @"version": packageVersion }];
+        }
+    }
+    if (name == nil && version == nil && packages == nil) return nil;
+    NSMutableDictionary<NSString *, id> *result = [NSMutableDictionary new];
+    if (name != nil) result[@"name"] = name;
+    if (version != nil) result[@"version"] = version;
+    if (packages != nil) result[@"packages"] = packages;
+    return result;
+}
+
+static void BillManagerScrubStacktrace(SentryStacktrace *_Nullable stacktrace)
+{
+    // Cocoa 8.58 serializes this raw dictionary even when there are no frames.
+    stacktrace.registers = @{};
+    for (SentryFrame *frame in stacktrace.frames) {
+        frame.fileName = nil;
+        frame.package = nil;
+        frame.vars = nil;
+        frame.contextLine = nil;
+        frame.preContext = nil;
+        frame.postContext = nil;
+    }
+}
+
+void BillManagerSentryScrubEvent(SentryEvent *event)
+{
+    event.message = nil;
+    event.error = nil;
+    event.logger = nil;
+    event.serverName = nil;
+    event.transaction = nil;
+    event.tags = nil;
+    event.extra = nil;
+    event.fingerprint = nil;
+    event.user = nil;
+    event.context = nil;
+    event.breadcrumbs = nil;
+    event.request = nil;
+    event.modules = nil;
+    event.sdk = BillManagerScrubSdk(event.sdk);
+    // Mach-O lookup uses the debug UUID, not private runtime paths. Relay still
+    // requires code_file to be nonempty. Cocoa 9 sends macho images only and
+    // no longer has the legacy apple `name` field.
+    for (SentryDebugMeta *image in event.debugMeta) {
+        image.codeFile = [image.type isEqualToString:@"macho"] ? BillManagerRedactedEventValue : nil;
+    }
+    BillManagerScrubStacktrace(event.stacktrace);
+    for (SentryThread *thread in event.threads) {
+        thread.name = nil;
+        BillManagerScrubStacktrace(thread.stacktrace);
+    }
+    for (SentryException *exception in event.exceptions) {
+        exception.value = BillManagerRedactedEventValue;
+        exception.module = nil;
+        exception.mechanism.desc = nil;
+        exception.mechanism.data = nil;
+        exception.mechanism.helpLink = nil;
+        BillManagerScrubStacktrace(exception.stacktrace);
+    }
+}
