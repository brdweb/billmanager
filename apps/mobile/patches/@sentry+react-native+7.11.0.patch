+package io.sentry.react;
+
+import io.sentry.Hint;
+import io.sentry.SentryEvent;
+import io.sentry.protocol.DebugImage;
+import io.sentry.protocol.DebugMeta;
+import io.sentry.protocol.SdkVersion;
+import io.sentry.protocol.SentryPackage;
+import io.sentry.protocol.Mechanism;
+import io.sentry.protocol.SentryException;
+import io.sentry.protocol.SentryStackFrame;
+import io.sentry.protocol.SentryStackTrace;
+import io.sentry.protocol.SentryThread;
+import java.util.List;
+import java.util.Set;
+import java.util.regex.Pattern;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+final class BillManagerSentryPrivacy {
+  private static final String REDACTED_EVENT_VALUE = "[redacted]";
+  private static final Pattern SDK_NAME =
+      Pattern.compile("sentry\\.(?:javascript(?:\\.[a-z-]+)*|cocoa|(?:java|native)(?:\\.android(?:\\.react-native)?)?)");
+  private static final Pattern VERSION =
+      Pattern.compile("\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?");
+  private static final Pattern PACKAGE_NAME =
+      Pattern.compile("(?:npm:@sentry/[a-z-]+|cocoapods:Sentry|maven:io\\.sentry:sentry(?:-android(?:-core|-ndk)?)?)");
+  private static final Pattern CODE_SYMBOL =
+      Pattern.compile("[A-Za-z_$~][A-Za-z0-9_$.:<>()\\[\\],*&~+!=%|^\\-]{0,255}");
+  private static final Pattern OBJC_SYMBOL =
+      Pattern.compile("[-+]\\[[A-Za-z_][A-Za-z0-9_]*(?:\\([A-Za-z_][A-Za-z0-9_]*\\))? [A-Za-z_][A-Za-z0-9_:]*\\]");
+
+  private BillManagerSentryPrivacy() {}
+
+  static void scrub(final @NotNull SentryEvent event, final @NotNull Hint hint) {
+    event.setMessage(null);
+    event.setLogger(null);
+    event.setRequest(null);
+    event.setUser(null);
+    event.setServerName(null);
+    event.setBreadcrumbs(null);
+    event.setExtras(null);
+    event.setTags(null);
+    event.setTransaction(null);
+    event.setFingerprints(null);
+    event.setThrowable(null);
+    event.setUnknown(null);
+    event.setModules(null);
+    scrubSdk(event);
+    scrubDebugMeta(event.getDebugMeta());
+
+    event.getContexts().entrySet().clear();
+
+    final @Nullable List<SentryException> exceptions = event.getExceptions();
+    if (exceptions != null) {
+      for (final SentryException exception : exceptions) {
+        exception.setValue(REDACTED_EVENT_VALUE);
+        exception.setModule(null);
+        exception.setUnknown(null);
+        scrubStacktrace(exception.getStacktrace());
+        final @Nullable Mechanism mechanism = exception.getMechanism();
+        if (mechanism != null) {
+          mechanism.setDescription(null);
+          mechanism.setHelpLink(null);
+          mechanism.setData(null);
+          mechanism.setMeta(null);
+          mechanism.setUnknown(null);
+        }
+      }
+    }
+
+    final @Nullable List<SentryThread> threads = event.getThreads();
+    if (threads != null) {
+      for (final SentryThread thread : threads) {
+        thread.setName(null);
+        thread.setHeldLocks(null);
+        thread.setUnknown(null);
+        scrubStacktrace(thread.getStacktrace());
+      }
+    }
+
+    hint.clearAttachments();
+    hint.setScreenshot(null);
+    hint.setViewHierarchy(null);
+    hint.setThreadDump(null);
+    hint.setReplayRecording(null);
+  }
+
+  private static void scrubStacktrace(final @Nullable SentryStackTrace stacktrace) {
+    if (stacktrace == null) return;
+    stacktrace.setRegisters(null);
+    stacktrace.setUnknown(null);
+    if (stacktrace.getFrames() == null) return;
+    for (final SentryStackFrame frame : stacktrace.getFrames()) {
+      frame.setFilename(bundlePath(frame.getFilename()));
+      frame.setAbsPath(bundlePath(frame.getAbsPath()));
+      frame.setPackage(null);
+      frame.setLock(null);
+      frame.setRawFunction(null);
+      frame.setFunction(codeSymbol(frame.getFunction()));
+      frame.setModule(codeSymbol(frame.getModule()));
+      frame.setSymbol(codeSymbol(frame.getSymbol()));
+      frame.setVars(null);
+      frame.setContextLine(null);
+      frame.setPreContext(null);
+      frame.setPostContext(null);
+      frame.setUnknown(null);
+    }
+  }
+
+  private static void scrubSdk(final @NotNull SentryEvent event) {
+    final @Nullable SdkVersion sdk = event.getSdk();
+    if (sdk == null) return;
+    if (!SDK_NAME.matcher(sdk.getName()).matches()
+        || !VERSION.matcher(sdk.getVersion()).matches()) {
+      event.setSdk(null);
+      return;
+    }
+    sdk.setUnknown(null);
+    // These sets can be the SDK's shared metadata registry. Clearing integration
+    // names changes serialized metadata only, not the active integrations.
+    sdk.getIntegrationSet().clear();
+    final Set<SentryPackage> packages = sdk.getPackageSet();
+    for (final SentryPackage pkg : packages) {
+      if (!PACKAGE_NAME.matcher(pkg.getName()).matches()
+          || !VERSION.matcher(pkg.getVersion()).matches()) {
+        packages.remove(pkg);
+      } else {
+        pkg.setUnknown(null);
+      }
+    }
+  }
+
+  private static void scrubDebugMeta(final @Nullable DebugMeta meta) {
+    if (meta == null) return;
+    meta.setUnknown(null);
+    meta.setSdkInfo(null);
+    if (meta.getImages() == null) return;
+    for (final DebugImage image : meta.getImages()) {
+      image.setCodeFile(bundlePath(image.getCodeFile()));
+      image.setDebugFile(null);
+      image.setUnknown(null);
+    }
+  }
+
+  private static @Nullable String codeSymbol(final @Nullable String value) {
+    if (value == null) return null;
+    if (OBJC_SYMBOL.matcher(value).matches()
+        || "operator new".equals(value)
+        || "operator new[]".equals(value)
+        || "operator delete".equals(value)
+        || "operator delete[]".equals(value)) return value;
+    if (!CODE_SYMBOL.matcher(value).matches()) return null;
+    for (int i = 0; i < value.length(); i++) {
+      if (value.charAt(i) != ':') continue;
+      if (i + 1 >= value.length() || value.charAt(i + 1) != ':') return null;
+      i++;
+    }
+    return value;
+  }
+
+  private static @Nullable String bundlePath(final @Nullable String value) {
+    if (value == null) return null;
+    int end = value.length();
+    final int query = value.indexOf('?');
+    final int fragment = value.indexOf('#');
+    if (query >= 0) end = Math.min(end, query);
+    if (fragment >= 0) end = Math.min(end, fragment);
+    final String path = end == value.length() ? value : value.substring(0, end);
+    final String name = path.startsWith("app:///") ? path.substring(7) : path;
+    return "index.bundle".equals(name)
+            || "index.android.bundle".equals(name)
+            || "index.ios.bundle".equals(name)
+            || "main.jsbundle".equals(name)
+        ? path
+        : null;
+  }
+}
