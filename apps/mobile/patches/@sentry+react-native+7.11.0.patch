+#import "BillManagerSentryPrivacy.h"
+
+@import Sentry;
+
+static NSString *const BillManagerRedactedEventValue = @"[redacted]";
+
+static void BillManagerScrubStacktrace(SentryStacktrace *_Nullable stacktrace)
+{
+    for (SentryFrame *frame in stacktrace.frames) {
+        frame.fileName = nil;
+        frame.package = nil;
+        frame.vars = nil;
+        frame.contextLine = nil;
+        frame.preContext = nil;
+        frame.postContext = nil;
+    }
+}
+
+void BillManagerSentryScrubEvent(SentryEvent *event)
+{
+    event.message = nil;
+    event.error = nil;
+    event.logger = nil;
+    event.serverName = nil;
+    event.transaction = nil;
+    event.tags = nil;
+    event.extra = nil;
+    event.fingerprint = nil;
+    event.user = nil;
+    event.context = nil;
+    event.breadcrumbs = nil;
+    event.request = nil;
+    // Preserve debug UUIDs and image addresses/sizes for dSYM symbolication, not runtime paths.
+    for (SentryDebugMeta *image in event.debugMeta) {
+        image.codeFile = nil;
+        image.name = nil;
+    }
+    BillManagerScrubStacktrace(event.stacktrace);
+    for (SentryThread *thread in event.threads) {
+        thread.name = nil;
+        BillManagerScrubStacktrace(thread.stacktrace);
+    }
+    for (SentryException *exception in event.exceptions) {
+        exception.value = BillManagerRedactedEventValue;
+        exception.module = nil;
+        exception.mechanism.desc = nil;
+        exception.mechanism.data = nil;
+        exception.mechanism.helpLink = nil;
+        BillManagerScrubStacktrace(exception.stacktrace);
+    }
+}
